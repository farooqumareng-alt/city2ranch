# Database (Postgres — e.g. Supabase: Project Settings > Database > Connection string)
DATABASE_URL=

# Supabase Auth (magic-link) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email (Resend — https://resend.com)
RESEND_API_KEY=
CONCIERGE_NOTIFY_EMAIL=
EMAIL_FROM=notifications@city2ranch.com

# Stripe (test mode — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe recurring Price ids for Membership (dashboard > Product catalog —
# create a monthly recurring Price per tier, not a one-off price). Also
# requires staff to turn on "Membership Sales" from /internal/dispatch/
# settings — real subscribing stays off until both are true.
STRIPE_PRICE_ROUTE=
STRIPE_PRICE_PRIVATE=
STRIPE_PRICE_ESTATE=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Recurring Services cron (src/app/api/cron/recurring-services) — Vercel
# automatically sends this as `Authorization: Bearer <value>` on its
# scheduled invocations (see vercel.json) when this env var is set on
# the project; generate any long random string.
CRON_SECRET=
